# Groq API Key (Get one at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (Get one at: https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Ollama Configuration
OLLAMA_MODELS=llama3.1:latest,llama3.1:8b,qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# LLM call tuning
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Workflow tuning
MAX_REVISIONS=3
MAX_SUB_QUERIES=3

# Where LangGraph checkpoints are persisted (survives process restarts)
CHECKPOINT_DB_PATH=data/checkpoints.db

# CORS: origin the Next.js frontend is served from
FRONTEND_ORIGIN=http://localhost:3000

# Optional — LangSmith tracing (https://smith.langchain.com). Picked up
# natively by LangChain; no code changes needed.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=ls__...
# LANGSMITH_PROJECT=polyagentic-research-assistant
